DATABASE_URL="mysql://username:password@localhost:3306/cbt_database"
PORT=3000
JWT_SECRET="replace_with_a_strong_secret"
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
# Dev-only: allow any *.ngrok-free.app / *.ngrok.app origin for the ngrok
# forwarding setup. Keep OFF in production.
ALLOW_NGROK_ORIGINS=false
# Dev/demo: allow any *.vercel.app origin so the dashboard hosted on Vercel can
# call this API (via the ngrok backend URL). For production, pin the exact
# Vercel domain in CORS_ORIGINS instead and keep this OFF.
ALLOW_VERCEL_ORIGINS=false