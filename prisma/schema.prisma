generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// NAMING CONVENTIONS:
//   Model names   → PascalCase English
//   Table names   → snake_case English (via @@map)
//   Field names   → snake_case English
//   Enum types    → PascalCase English
//   Enum values   → UPPER_SNAKE English
// ============================================

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  password       String
  role           Role
  is_active      Boolean  @default(true)
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  admin          Admin?
  teacher        Teacher?
  student        Student?

  @@map("users")
}

model Admin {
  admin_id  Int    @id @default(autoincrement())
  full_name String
  user_id   Int    @unique
  user      User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Teacher {
  teacher_id     Int             @id @default(autoincrement())
  full_name      String
  nip            String?         @unique
  subject        String          @db.VarChar(100)
  is_coordinator Boolean         @default(false)
  user_id        Int             @unique
  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  questions      Question[]
  exams          Exam[]
  question_banks QuestionBank[]

  @@index([subject])
  @@map("teachers")
}

model Student {
  student_id        Int                @id @default(autoincrement())
  full_name         String
  nisn              String?            @unique
  classroom         String
  grade_level       String
  major             String
  user_id           Int                @unique
  exam_participants ExamParticipant[]
  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("students")
}

model ActivityLog {
  log_id              Int      @id @default(autoincrement())
  user_id             Int?
  exam_participant_id Int?
  activity_type       String   @db.VarChar(100)
  description         String   @db.Text
  ip_address          String?  @db.VarChar(50)
  user_agent          String?  @db.Text
  metadata            String?  @db.LongText
  created_at          DateTime @default(now())

  @@index([activity_type])
  @@index([created_at])
  @@index([exam_participant_id])
  @@index([user_id])
  @@map("activity_logs")
}

model ExamResult {
  exam_result_id      Int             @id @default(autoincrement())
  final_score         Float
  submit_date         DateTime        @default(now())
  exam_participant_id Int             @unique
  exam_participant    ExamParticipant @relation(fields: [exam_participant_id], references: [exam_participant_id], onDelete: Cascade)

  @@map("exam_results")
}

model Answer {
  answer_id           Int             @id @default(autoincrement())
  essay_answer_text   String?         @db.Text
  mc_option_ids       String?         @db.Text
  is_correct          Boolean?
  manual_score        Float?
  created_at          DateTime        @default(now())
  exam_participant_id Int
  question_id         Int
  exam_participant    ExamParticipant @relation(fields: [exam_participant_id], references: [exam_participant_id], onDelete: Cascade)
  question            Question        @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([exam_participant_id, question_id])
  @@index([exam_participant_id])
  @@index([question_id])
  @@map("answers")
}

model Migration {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int

  @@map("migrations")
}

model AnswerOption {
  option_id   Int      @id @default(autoincrement())
  label       String
  option_text String   @db.Text
  is_correct  Boolean  @default(false)
  question_id Int
  question    Question @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@index([question_id])
  @@map("answer_options")
}

model ExamParticipant {
  exam_participant_id Int                   @id @default(autoincrement())
  exam_status         ExamParticipantStatus @default(NOT_STARTED)
  start_time          DateTime?
  end_time            DateTime?
  exam_id             Int
  student_id          Int
  is_blocked          Boolean               @default(false)
  block_reason        String?               @db.Text
  unlock_code         String?               @unique
  exam_result         ExamResult?
  answers             Answer[]
  student             Student               @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  exam                Exam                  @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@index([exam_status])
  @@index([student_id])
  @@index([exam_id])
  @@map("exam_participants")
}

model ExamQuestion {
  exam_question_id Int      @id @default(autoincrement())
  score_weight     Int
  sequence         Int
  exam_id          Int
  question_id      Int
  question         Question @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  exam             Exam     @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)

  @@unique([exam_id, question_id])
  @@index([question_id])
  @@index([exam_id])
  @@map("exam_questions")
}

model QuestionBank {
  question_bank_id Int        @id @default(autoincrement())
  bank_name        String     @unique
  description      String?    @db.Text
  subject          String
  grade_level      String
  major            String?
  teacher_id       Int
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  teacher          Teacher    @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)
  questions        Question[]

  @@index([teacher_id])
  @@map("question_banks")
}

model Question {
  question_id          Int            @id @default(autoincrement())
  question_type        QuestionType
  question_text        String         @db.Text
  subject              String
  grade_level          String
  major                String?
  question_image       String?
  question_explanation String?        @db.Text
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  teacher_id           Int
  question_bank_id     Int
  answers              Answer[]
  answer_options       AnswerOption[]
  exam_questions       ExamQuestion[]
  teacher              Teacher        @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)
  question_bank        QuestionBank   @relation(fields: [question_bank_id], references: [question_bank_id])

  @@index([teacher_id])
  @@index([question_bank_id])
  @@map("questions")
}

model Exam {
  exam_id              Int                @id @default(autoincrement())
  exam_name            String
  subject              String
  grade_level          String
  major                String?
  start_date           DateTime
  end_date             DateTime
  duration_minutes     Int
  is_shuffle_questions Boolean            @default(false)
  exam_status          ExamStatus         @default(SCHEDULED)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  teacher_id           Int
  exam_participants    ExamParticipant[]
  exam_questions       ExamQuestion[]
  teacher              Teacher            @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)

  @@index([exam_status])
  @@index([end_date])
  @@index([teacher_id])
  @@map("exams")
}

enum Role {
  admin
  teacher
  student
}

enum ExamParticipantStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  GRADED
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  ENDED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

// ============================================
// SCHOOL PROFILE (singleton – only 1 row)
// ============================================
model SchoolProfile {
  id               Int      @id @default(1)
  school_name      String   @default("Nama Sekolah")
  npsn             String?  @db.VarChar(20)
  address          String?  @db.Text
  city             String?  @db.VarChar(100)
  province         String?  @db.VarChar(100)
  postal_code      String?  @db.VarChar(10)
  phone            String?  @db.VarChar(30)
  email            String?  @db.VarChar(100)
  website          String?  @db.VarChar(200)
  logo_url         String?  @db.Text
  principal_name   String?  @db.VarChar(200)
  school_level     String?  @db.VarChar(20) // SMA, SMK, MA, dll
  accreditation    String?  @db.VarChar(5)  // A, B, C, Unggul, Baik, dll
  updated_at       DateTime @updatedAt

  @@map("school_profiles")
}
